<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.assistant.adapter.memory">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- KILL_BACKGROUND_PROCESSES: required by AggressiveMemoryHoarding.killBackgroundProcesses() -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true">
        
        <service
            android:name=".MemoryAdapterService"
            android:exported="true"
            android:process=":kernel"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="Monitors memory pressure and RAM telemetry."/>
        </service>
    </application>
</manifest>
