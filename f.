import re
import os

def patch_watchdog_system():
    # 1. Patch AndroidManifest.xml to add WAKE_LOCK permission
    manifest_path = "app/src/main/AndroidManifest.xml"
    if os.path.exists(manifest_path):
        with open(manifest_path, 'r', encoding='utf-8') as f:
            manifest = f.read()
        
        if 'android.permission.WAKE_LOCK' not in manifest:
            manifest = manifest.replace(
                '<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />',
                '<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />\n    <uses-permission android:name="android.permission.WAKE_LOCK" />'
            )
            with open(manifest_path, 'w', encoding='utf-8') as f:
                f.write(manifest)
            print("[SUCCESS] Added WAKE_LOCK permission to AndroidManifest.xml")
        else:
            print("[INFO] WAKE_LOCK permission already exists in AndroidManifest.xml")

    # 2. Patch NodeNotificationHub.kt to elevate LMK priority
    hub_path = "core/src/main/java/com/assistant/diagnostic/notification/NodeNotificationHub.kt"
    if os.path.exists(hub_path):
        with open(hub_path, 'r', encoding='utf-8') as f:
            hub_code = f.read()
        
        # Change IMPORTANCE_MIN to IMPORTANCE_LOW to prevent aggressive HyperOS LMK targeting
        # while remaining silent (no sound/badge)
        if 'NotificationManager.IMPORTANCE_MIN' in hub_code:
            hub_code = hub_code.replace(
                'NotificationManager.IMPORTANCE_MIN',
                'NotificationManager.IMPORTANCE_LOW'
            )
            with open(hub_path, 'w', encoding='utf-8') as f:
                f.write(hub_code)
            print("[SUCCESS] Elevated NodeNotificationHub channel to IMPORTANCE_LOW to prevent HyperOS LMK targeting.")
        else:
            print("[INFO] NodeNotificationHub already uses elevated importance.")

    # 3. Patch WatchdogAdapterService.kt to add CPU WakeLock lifecycle
    watchdog_path = "app/src/main/java/com/assistant/adapter/watchdog/WatchdogAdapterService.kt"
    if os.path.exists(watchdog_path):
        with open(watchdog_path, 'r', encoding='utf-8') as f:
            watchdog_code = f.read()
        
        # Add imports
        if 'import android.content.Context' not in watchdog_code:
            watchdog_code = watchdog_code.replace(
                'import android.app.Service',
                'import android.app.Service\nimport android.content.Context\nimport android.os.PowerManager'
            )
        
        # Add wakeLock variable
        if 'private var wakeLock: PowerManager.WakeLock? = null' not in watchdog_code:
            watchdog_code = watchdog_code.replace(
                '@Volatile private var totalRestarts = 0',
                '@Volatile private var totalRestarts = 0\n    @Volatile private var wakeLock: PowerManager.WakeLock? = null'
            )
        
        # Add wakeLock acquisition in onCreate
        onCreate_pattern = r'(override fun onCreate\(\) \{\s+super\.onCreate\(\)\s+RuntimeLogger\.log\("WatchdogAdapterService started - ACTIVE GUARDIAN", "ADAPTER"\)\s+NodeNotificationHub\.attach\(this, "adapter_watchdog"\))'
        onCreate_replacement = r'''\1
        // HYPEROS LMK SURVIVAL: Acquire PARTIAL_WAKE_LOCK to prevent CPU dozing during 15s watchdog scans
        val pm = getSystemService(Context.POWER_SERVICE) as PowerManager
        wakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "Splendor:WatchdogWakeLock").apply {
            acquire(10 * 60 * 1000L) // 10 minutes, renewable on each scan cycle
        }'''
        watchdog_code = re.sub(onCreate_pattern, onCreate_replacement, watchdog_code)
        
        # Add wakeLock renewal in watchdogRunnable
        watchdog_pattern = r'(lastScan = "offline=\$offline degraded=\$degraded restarted=\$restarted"\s+watchdogHandler\.postDelayed\(this, 15000\))'
        watchdog_replacement = r'''\1
            // HYPEROS LMK SURVIVAL: Renew WakeLock timeout on every successful scan cycle
            wakeLock?.acquire(10 * 60 * 1000L)'''
        watchdog_code = re.sub(watchdog_pattern, watchdog_replacement, watchdog_code)
        
        # Add wakeLock release in onDestroy
        onDestroy_pattern = r'(override fun onDestroy\(\) \{\s+heartbeatHandler\.removeCallbacksAndMessages\(null\)\s+watchdogHandler\.removeCallbacksAndMessages\(null\)\s+NodeNotificationHub\.detach\(this, "adapter_watchdog"\))'
        onDestroy_replacement = r'''\1
        // HYPEROS LMK SURVIVAL: Release WakeLock to prevent battery drain on service shutdown
        wakeLock?.let { if (it.isHeld) it.release() }'''
        watchdog_code = re.sub(onDestroy_pattern, onDestroy_replacement, watchdog_code)
        
        with open(watchdog_path, 'w', encoding='utf-8') as f:
            f.write(watchdog_code)
        print("[SUCCESS] Injected CPU WakeLock lifecycle into WatchdogAdapterService.kt")

if __name__ == "__main__":
    print("Initiating HyperOS High-Priority Foreground Watchdog System Patch...")
    patch_watchdog_system()
    print("Patch Execution Complete.")
