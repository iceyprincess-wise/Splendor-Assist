<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths (updater Piece 4): the downloaded release APK
  lives in the app's external files Download/ dir
  (DownloadManager.setDestinationInExternalFilesDir with
  Environment.DIRECTORY_DOWNLOADS). The install intent shares it via
  FileProvider with authority com.assistant.overlay.fileprovider.
-->
<paths>
    <external-files-path name="downloads" path="Download/" />
</paths>
