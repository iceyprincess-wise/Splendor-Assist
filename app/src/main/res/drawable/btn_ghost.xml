<?xml version="1.0" encoding="utf-8"?>
<!--
  Ghost button (re-touch, round no60).

  NO60-D7 (cyan unification): stroke was #4D00D4FF (the layouts' cyan
  at 30% alpha). Now #4D00E5FF — the theme secondary at the same alpha.
  Ripple tint matches (#337C4DFF). Transparent fill and 27dp pill
  radius unchanged, so the ghost still reads as the outline twin of
  button_premium.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#337C4DFF">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#00101828" />
      <corners android:radius="27dp" />
      <stroke android:width="1dp" android:color="#4D00E5FF" />
    </shape>
  </item>
</ripple>
