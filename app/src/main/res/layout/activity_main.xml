<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#173A6A">
    <com.google.android.material.card.MaterialCardView
    android:tag="PHASE10_MATERIAL_DASHBOARD_CARD_MARKER"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="18dp"
    app:cardUseCompatPadding="true">

    <LinearLayout android:baselineAligned="false"
    android:tag="PHASE10_MATERIAL3_LAYOUT_MARKER"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:id="@+id/tvTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_3" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="28sp"/>
        <TextView android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_4" android:textColor="#B8CCE6"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnStartEngine"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_5" android:textStyle="bold"
            android:background="@drawable/button_premium" android:textColor="#FFFFFF"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStopEngine"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_6" android:textStyle="bold"
            android:background="@drawable/button_premium" android:textColor="#FFFFFF"/>

        <TextView android:id="@+id/txtRuntimeHub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="@string/auto_extracted_7" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnViewLogs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/auto_extracted_8"
            android:background="@drawable/button_premium" android:textColor="#FFFFFF"/>

        <TextView android:id="@+id/tvOptimizationTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/auto_extracted_9"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp"/>
        <TextView android:id="@+id/tvOptimizationBanner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:padding="14dp"
            android:background="@drawable/banner_premium"
            android:text="@string/auto_extracted_10"
            android:textColor="#FFFFFF"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="vertical">

            <!-- ROW 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">

                <!-- SMART ASSIST -->
                <LinearLayout android:id="@+id/cardSmartAssist"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:background="@drawable/card_outer_premium"
                    android:padding="2dp" android:clickable="true" android:focusable="true"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/card_inner_premium"
                        android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <TextView android:id="@+id/tvSmartAssistBulb"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_11" android:textSize="14sp" android:textColor="#40E36A"/>
                        <TextView android:id="@+id/tvSmartAssistState"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_12" android:textSize="12sp" android:textColor="#B8CCE6"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_13" android:textSize="24sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_14" android:textColor="#FFFFFF"
                            android:textStyle="bold" android:textSize="12sp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- GOALKEEPER -->
                <LinearLayout android:id="@+id/cardGoalkeeper"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:background="@drawable/card_outer_premium"
                    android:padding="2dp" android:clickable="true" android:focusable="true"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/card_inner_premium"
                        android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <TextView android:id="@+id/tvGoalkeeperBulb"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_15" android:textSize="14sp" android:textColor="#D0D0D0"/>
                        <TextView android:id="@+id/tvGoalkeeperState"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_16" android:textSize="12sp" android:textColor="#B8CCE6"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_17" android:textSize="24sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_18" android:textColor="#FFFFFF"
                            android:textStyle="bold" android:textSize="12sp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- INTERCEPTION -->
                <LinearLayout android:id="@+id/cardInterception"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_outer_premium"
                    android:padding="2dp" android:clickable="true" android:focusable="true"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/card_inner_premium"
                        android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <TextView android:id="@+id/tvInterceptionBulb"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_19" android:textSize="14sp" android:textColor="#D0D0D0"/>
                        <TextView android:id="@+id/tvInterceptionState"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_20" android:textSize="12sp" android:textColor="#B8CCE6"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_21" android:textSize="24sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_22" android:textColor="#FFFFFF"
                            android:textStyle="bold" android:textSize="12sp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <!-- ROW 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">

                <LinearLayout android:id="@+id/cardOverlay"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:background="@drawable/card_outer_premium"
                    android:padding="2dp" android:clickable="true" android:focusable="true"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/card_inner_premium"
                        android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_23" android:textSize="24sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_24" android:textColor="#FFFFFF"
                            android:textStyle="bold" android:textSize="12sp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardAccessibility"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:background="@drawable/card_outer_premium"
                    android:padding="2dp" android:clickable="true" android:focusable="true"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/card_inner_premium"
                        android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_25" android:textSize="24sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_26" android:textColor="#FFFFFF"
                            android:textStyle="bold" android:textSize="12sp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardNotifications"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_outer_premium"
                    android:padding="2dp" android:clickable="true" android:focusable="true"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/card_inner_premium"
                        android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_27" android:textSize="24sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_28" android:textColor="#FFFFFF"
                            android:textStyle="bold" android:textSize="12sp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <!-- ROW 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/cardMediaProjection"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:background="@drawable/card_outer_premium"
                    android:padding="2dp" android:clickable="true" android:focusable="true"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/card_inner_premium"
                        android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_29" android:textSize="24sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_30" android:textColor="#FFFFFF"
                            android:textStyle="bold" android:textSize="12sp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardDiagnostics"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:background="@drawable/card_outer_premium"
                    android:padding="2dp" android:clickable="true" android:focusable="true"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/card_inner_premium"
                        android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_31" android:textSize="24sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_32" android:textColor="#FFFFFF"
                            android:textStyle="bold" android:textSize="12sp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardFutureRooms"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_outer_premium"
                    android:padding="2dp" android:clickable="true" android:focusable="true"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/card_inner_premium"
                        android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <TextView android:id="@+id/tvFutureBulb"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_33" android:textSize="14sp" android:textColor="#40E36A"/>
                        <TextView android:id="@+id/tvFutureState"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_34" android:textSize="12sp" android:textColor="#B8CCE6"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_35" android:textSize="24sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/auto_extracted_36" android:textColor="#FFFFFF"
                            android:textStyle="bold" android:textSize="12sp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>



    <LinearLayout
        android:id="@+id/runtimeStatusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/txtRuntimeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_extracted_37"/>

        <TextView
            android:id="@+id/txtVisionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_extracted_38"/>

        <TextView
            android:id="@+id/txtDiagnosticsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_extracted_39"/>

    </LinearLayout>



        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_40"
            android:textColor="#6B8AAA" android:textSize="12sp"
            android:layout_marginTop="24dp" android:layout_gravity="center_horizontal"/>
    </LinearLayout></com.google.android.material.card.MaterialCardView>

</ScrollView>
