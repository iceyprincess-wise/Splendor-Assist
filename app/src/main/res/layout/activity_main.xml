        <Space android:layout_width="12dp" android:layout_height="1dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStopEngine"
            android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1"
            style="@style/Widget.SplendorAssist.Button.Ghost"
            android:background="@drawable/button_dashboard_ghost"
            android:text="@string/auto_extracted_6" />
      </LinearLayout>

      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="20dp" android:padding="14dp"
          android:background="@drawable/banner_premium"
