<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#070B14" android:fillViewport="true" android:overScrollMode="never">
  <com.google.android.material.card.MaterialCardView
      android:tag="PHASE10_MATERIAL_DASHBOARD_CARD_MARKER"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      app:cardCornerRadius="0dp" app:cardBackgroundColor="@android:color/transparent"
      app:cardElevation="0dp" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,DisableBaselineAlignment,ButtonStyle,UseCompoundDrawables" android:baselineAligned="false"
        android:tag="PHASE10_MATERIAL3_LAYOUT_MARKER"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="SPLENDOR" android:textSize="12sp" android:textStyle="bold"
          android:textColor="#00D4FF" android:letterSpacing="0.3"/>
      <TextView android:id="@+id/tvTitle"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="SPLENDOR ASSIST 2027" android:textColor="#E8EEF9"
          android:textStyle="bold" android:textSize="30sp" android:layout_marginTop="4dp"/>
      <TextView android:id="@+id/tvSubtitle"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="NATIVE C MUTATION ENGINE ACTIVE" android:textColor="#9FB3D1"
          android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.12"
          android:layout_marginTop="6dp" android:layout_marginBottom="20dp"/>

      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStartEngine"
            android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1"
            android:text="@string/auto_extracted_5" android:textStyle="bold" android:textSize="14sp"
            android:letterSpacing="0.06" android:textColor="#FFFFFF"
            android:background="@drawable/button_premium"/>
        <Space android:layout_width="12dp" android:layout_height="1dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStopEngine"
            android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1"
            android:text="@string/auto_extracted_6" android:textStyle="bold" android:textSize="14sp"
            android:letterSpacing="0.06" android:textColor="#00D4FF"
            android:background="@drawable/btn_ghost"/>
      </LinearLayout>

      <TextView android:id="@+id/txtRuntimeHub"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="16dp" android:textSize="11sp"
          android:fontFamily="monospace" android:textColor="#5C7399"
          android:text="@string/auto_extracted_7"/>

      <TextView android:id="@+id/tvOptimizationTitle"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="28dp" android:text="@string/auto_extracted_9"
          android:textColor="#E8EEF9" android:textStyle="bold" android:textSize="18sp"/>
      <TextView android:id="@+id/tvOptimizationBanner"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="10dp" android:padding="14dp"
          android:background="@drawable/banner_premium"
          android:text="@string/auto_extracted_10" android:textColor="#C7D2E5" android:textSize="13sp"/>

      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="CONTROL ROOMS" android:textSize="12sp" android:textStyle="bold"
          android:textColor="#00D4FF" android:letterSpacing="0.2"
          android:layout_marginTop="24dp" android:layout_marginBottom="12dp"/>

      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <LinearLayout android:id="@+id/cardSmartAssist"
                android:layout_width="0dp" android:layout_height="124dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:background="@drawable/card_outer_premium" android:padding="2dp"
                android:clickable="true" android:focusable="true" android:orientation="vertical">
              <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                  android:background="@drawable/card_inner_premium" android:gravity="center"
                  android:orientation="vertical" android:padding="6dp">
            <TextView android:id="@+id/tvSmartAssistBulb" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_11" android:textSize="12sp" android:textColor="#00E676"/>
            <TextView android:id="@+id/tvSmartAssistState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_12" android:textSize="10sp" android:textColor="#9FB3D1" android:letterSpacing="0.1" android:layout_marginTop="2dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_13" android:textSize="26sp" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_14" android:textColor="#E8EEF9" android:textStyle="bold"
                android:textSize="11sp" android:gravity="center" android:letterSpacing="0.05" android:layout_marginTop="4dp"/>
              </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardGoalkeeper"
                android:layout_width="0dp" android:layout_height="124dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:background="@drawable/card_outer_premium" android:padding="2dp"
                android:clickable="true" android:focusable="true" android:orientation="vertical">
              <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                  android:background="@drawable/card_inner_premium" android:gravity="center"
                  android:orientation="vertical" android:padding="6dp">
            <TextView android:id="@+id/tvGoalkeeperBulb" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_15" android:textSize="12sp" android:textColor="#00E676"/>
            <TextView android:id="@+id/tvGoalkeeperState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_16" android:textSize="10sp" android:textColor="#9FB3D1" android:letterSpacing="0.1" android:layout_marginTop="2dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_17" android:textSize="26sp" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_18" android:textColor="#E8EEF9" android:textStyle="bold"
                android:textSize="11sp" android:gravity="center" android:letterSpacing="0.05" android:layout_marginTop="4dp"/>
              </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardInterception"
                android:layout_width="0dp" android:layout_height="124dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:background="@drawable/card_outer_premium" android:padding="2dp"
                android:clickable="true" android:focusable="true" android:orientation="vertical">
              <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                  android:background="@drawable/card_inner_premium" android:gravity="center"
                  android:orientation="vertical" android:padding="6dp">
            <TextView android:id="@+id/tvInterceptionBulb" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_19" android:textSize="12sp" android:textColor="#00E676"/>
            <TextView android:id="@+id/tvInterceptionState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_20" android:textSize="10sp" android:textColor="#9FB3D1" android:letterSpacing="0.1" android:layout_marginTop="2dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_21" android:textSize="26sp" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_22" android:textColor="#E8EEF9" android:textStyle="bold"
                android:textSize="11sp" android:gravity="center" android:letterSpacing="0.05" android:layout_marginTop="4dp"/>
              </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <LinearLayout android:id="@+id/cardOverlay"
                android:layout_width="0dp" android:layout_height="124dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:background="@drawable/card_outer_premium" android:padding="2dp"
                android:clickable="true" android:focusable="true" android:orientation="vertical">
              <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                  android:background="@drawable/card_inner_premium" android:gravity="center"
                  android:orientation="vertical" android:padding="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_23" android:textSize="26sp" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_24" android:textColor="#E8EEF9" android:textStyle="bold"
                android:textSize="11sp" android:gravity="center" android:letterSpacing="0.05" android:layout_marginTop="4dp"/>
              </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardAccessibility"
                android:layout_width="0dp" android:layout_height="124dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:background="@drawable/card_outer_premium" android:padding="2dp"
                android:clickable="true" android:focusable="true" android:orientation="vertical">
              <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                  android:background="@drawable/card_inner_premium" android:gravity="center"
                  android:orientation="vertical" android:padding="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_25" android:textSize="26sp" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_26" android:textColor="#E8EEF9" android:textStyle="bold"
                android:textSize="11sp" android:gravity="center" android:letterSpacing="0.05" android:layout_marginTop="4dp"/>
              </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardNotifications"
                android:layout_width="0dp" android:layout_height="124dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:background="@drawable/card_outer_premium" android:padding="2dp"
                android:clickable="true" android:focusable="true" android:orientation="vertical">
              <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                  android:background="@drawable/card_inner_premium" android:gravity="center"
                  android:orientation="vertical" android:padding="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_27" android:textSize="26sp" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_28" android:textColor="#E8EEF9" android:textStyle="bold"
                android:textSize="11sp" android:gravity="center" android:letterSpacing="0.05" android:layout_marginTop="4dp"/>
              </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/cardMediaProjection"
                android:layout_width="0dp" android:layout_height="124dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:background="@drawable/card_outer_premium" android:padding="2dp"
                android:clickable="true" android:focusable="true" android:orientation="vertical">
              <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                  android:background="@drawable/card_inner_premium" android:gravity="center"
                  android:orientation="vertical" android:padding="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_29" android:textSize="26sp" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_30" android:textColor="#E8EEF9" android:textStyle="bold"
                android:textSize="11sp" android:gravity="center" android:letterSpacing="0.05" android:layout_marginTop="4dp"/>
              </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardDiagnostics"
                android:layout_width="0dp" android:layout_height="124dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:background="@drawable/card_outer_premium" android:padding="2dp"
                android:clickable="true" android:focusable="true" android:orientation="vertical">
              <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                  android:background="@drawable/card_inner_premium" android:gravity="center"
                  android:orientation="vertical" android:padding="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_31" android:textSize="26sp" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_32" android:textColor="#E8EEF9" android:textStyle="bold"
                android:textSize="11sp" android:gravity="center" android:letterSpacing="0.05" android:layout_marginTop="4dp"/>
              </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardFutureRooms"
                android:layout_width="0dp" android:layout_height="124dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:background="@drawable/card_outer_premium" android:padding="2dp"
                android:clickable="true" android:focusable="true" android:orientation="vertical">
              <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                  android:background="@drawable/card_inner_premium" android:gravity="center"
                  android:orientation="vertical" android:padding="6dp">
            <TextView android:id="@+id/tvFutureBulb" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_33" android:textSize="12sp" android:textColor="#00E676"/>
            <TextView android:id="@+id/tvFutureState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_34" android:textSize="10sp" android:textColor="#9FB3D1" android:letterSpacing="0.1" android:layout_marginTop="2dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_35" android:textSize="26sp" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/auto_extracted_36" android:textColor="#E8EEF9" android:textStyle="bold"
                android:textSize="11sp" android:gravity="center" android:letterSpacing="0.05" android:layout_marginTop="4dp"/>
              </LinearLayout>
            </LinearLayout>
        </LinearLayout>
      </LinearLayout>

      <LinearLayout android:id="@+id/runtimeStatusCard"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="20dp" android:orientation="vertical"
          android:background="@drawable/panel_surface" android:padding="16dp">
        <TextView android:id="@+id/txtRuntimeStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_37" android:textSize="12sp"
            android:fontFamily="monospace" android:textColor="#00E676"/>
        <TextView android:id="@+id/txtVisionStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_38" android:textSize="12sp"
            android:fontFamily="monospace" android:textColor="#9FB3D1" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/txtDiagnosticsStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_39" android:textSize="12sp"
            android:fontFamily="monospace" android:textColor="#9FB3D1" android:layout_marginTop="6dp"/>
      </LinearLayout>

      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/auto_extracted_40" android:textColor="#5C7399"
          android:textSize="11sp" android:letterSpacing="0.08"
          android:layout_marginTop="28dp" android:layout_gravity="center_horizontal"/>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</ScrollView>
