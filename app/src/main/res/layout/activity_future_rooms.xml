<!--
  Future Rooms (File No 101) — round no61, premium tokenisation.

  ORPHANED (PROVEN): FutureRoomsActivity never inflates this layout —
  it builds its entire UI programmatically (page()/mount()/text()/
  btn() in FutureRoomsActivity.kt) and never calls setContentView()
  with this layout. Zero references to any of its five ids
  (tvFutureEmoji, tvFutureTitle, tvFutureSubtitle, tvFutureList,
  btnBack) exist in any Kotlin file (HEAD 2a50b423). This file is the
  pre-PHASE4 UI, superseded by the programmatic screens. Documented
  here and kept, same as the welcome/update/error orphans in no60;
  wiring it to a real flow (or confirming it dead) is Ed's product
  call — see also Q60-6, which this file now joins.

  NO61-D5 (PROVEN): btnBack textColor was hardcoded #00D4FF — now
  Widget.SplendorAssist.Button.Ghost (cyan text, ghost outline).
  NO61-D6 (PROVEN): tvFutureList textColor was #C7D2E5, a fourth
  grey with no theme token. Mapped to ?attr/colorOnSurfaceVariant
  (#9FB3D1) — the same mapping no60 used for MainActivity's #C7D2E5
  banner text (activity_main.xml header comment). The list text is
  one step darker; it was already the muted grey of the screen.
  NO61-D10..D14 (PROVEN): every hardcoded colour -> theme token
  (background ?android:attr/colorBackground, titles Headline +
  ?attr/colorOnSurface, subtitles BodySmall +
  ?attr/colorOnSurfaceVariant, list Body +
  ?attr/colorOnSurfaceVariant, btnBack
  Widget.SplendorAssist.Button.Ghost). Subtitles move 13sp -> 12sp
  with the BodySmall system type (the one intentional size change).
  The 18dp list padding and the 52dp emoji box are kept as chosen
  values, not defects.
  NO61-D18 (PROVEN, documented, structure kept): the layout shows its
  title and subtitle TWICE — a static header (auto_extracted_66/_67)
  and tvFutureTitle/tvFutureSubtitle with the same two strings. A
  copy-paste duplicate from when the screen had both a header and a
  dynamic title. It is inert (nothing inflates the file) and the
  structure is kept as-is, like the other orphans; the duplicate is
  recorded here rather than silently edited away.
  NO61-D22 (discovery, NOT in this script): the LIVE future-rooms
  screen (FutureRoomsActivity's programmatic UI) is built entirely
  from ThemeTokens.kt — a parallel colour system of hardcoded hex
  constants (BG #070B14, TEXT #DDDDDD, BUTTON_ALT #00B8D4 — a fourth
  cyan — SUCCESS #4CAF50 vs the theme tertiary #00E676). The live
  screen is not tokenised. Needs an activity-code round; queued.
  All ids, texts and view order are preserved.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:fillViewport="true" android:overScrollMode="never">
  <LinearLayout xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,DisableBaselineAlignment,ButtonStyle,UseCompoundDrawables"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/auto_extracted_66"
        android:textColor="?attr/colorOnSurface"
        android:textAppearance="@style/TextAppearance.SplendorAssist.Headline" />
    <View android:layout_width="56dp" android:layout_height="3dp"
        android:layout_marginTop="10dp" android:layout_marginBottom="20dp"
        android:background="@drawable/accent_bar" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/auto_extracted_67" android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="@style/TextAppearance.SplendorAssist.BodySmall"
        android:layout_marginTop="4dp" android:layout_marginBottom="20dp" />
    <TextView android:id="@+id/tvFutureEmoji"
        android:layout_width="52dp" android:layout_height="52dp"
        android:background="@drawable/panel_surface" android:gravity="center"
        android:text="@string/auto_extracted_65" android:textSize="24sp"
        android:layout_marginBottom="14dp" />

    <TextView android:id="@+id/tvFutureTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/auto_extracted_66"
        android:textColor="?attr/colorOnSurface"
        android:textAppearance="@style/TextAppearance.SplendorAssist.Headline" />

    <TextView android:id="@+id/tvFutureSubtitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/auto_extracted_67" android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="@style/TextAppearance.SplendorAssist.BodySmall" android:layout_marginBottom="18dp" />

    <TextView android:id="@+id/tvFutureList"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="@style/TextAppearance.SplendorAssist.Body" android:lineSpacingExtra="6dp"
        android:padding="18dp" android:background="@drawable/panel_surface" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="24dp" android:text="@string/auto_extracted_68"
        style="@style/Widget.SplendorAssist.Button.Ghost" />

  </LinearLayout>
</ScrollView>
