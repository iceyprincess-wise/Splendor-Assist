<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#070B14" android:fillViewport="true" android:overScrollMode="never">
  <LinearLayout xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,DisableBaselineAlignment,ButtonStyle,UseCompoundDrawables"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/auto_extracted_49" android:textSize="26sp" android:textStyle="bold"
        android:textColor="#E8EEF9" android:letterSpacing="0.02"/>
    <View android:layout_width="56dp" android:layout_height="3dp"
        android:layout_marginTop="10dp" android:layout_marginBottom="20dp"
        android:background="@drawable/accent_bar"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/panel_surface"
        android:padding="8dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swEnabled" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_50" android:textColor="#E8EEF9" android:textSize="15sp"
            android:paddingTop="10dp" android:paddingBottom="10dp"/>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swPanic" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_51" android:textColor="#E8EEF9" android:textSize="15sp"
            android:paddingTop="10dp" android:paddingBottom="10dp"/>

    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/auto_extracted_52" android:textSize="12sp" android:textStyle="bold"
        android:textColor="#00D4FF" android:letterSpacing="0.15"
        android:layout_marginTop="20dp" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_53" android:textColor="#9FB3D1" android:textSize="12sp"
            android:layout_marginBottom="6dp"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/passSeek" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0" android:valueTo="100"
            app:thumbColor="#7C4DFF" app:trackColorActive="#7C4DFF" app:trackColorInactive="#1E2A44"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_54" android:textColor="#9FB3D1" android:textSize="12sp"
            android:layout_marginBottom="6dp"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/shotSeek" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0" android:valueTo="100"
            app:thumbColor="#7C4DFF" app:trackColorActive="#7C4DFF" app:trackColorInactive="#1E2A44"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_55" android:textColor="#9FB3D1" android:textSize="12sp"
            android:layout_marginBottom="6dp"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/crossSeek" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0" android:valueTo="100"
            app:thumbColor="#7C4DFF" app:trackColorActive="#7C4DFF" app:trackColorInactive="#1E2A44"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="AUTHORITY" android:textColor="#9FB3D1" android:textSize="12sp"
            android:layout_marginBottom="6dp"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/authoritySeek" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0" android:valueTo="100"
            app:thumbColor="#7C4DFF" app:trackColorActive="#7C4DFF" app:trackColorInactive="#1E2A44"/>
        <TextView android:id="@+id/tvAuthorityValue" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_56" android:textColor="#9FB3D1" android:textSize="12sp"
            android:fontFamily="monospace" android:layout_marginBottom="8dp"/>
    <TextView android:id="@+id/tvRuntime"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="#9FB3D1" android:textSize="12sp"
        android:fontFamily="monospace"/>
    <TextView android:id="@+id/tvMetrics"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="#5C7399" android:textSize="11sp"
        android:fontFamily="monospace"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="24dp" android:text="@string/auto_extracted_57"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"
        android:letterSpacing="0.06" android:background="@drawable/button_premium"/>

  </LinearLayout>
</ScrollView>
