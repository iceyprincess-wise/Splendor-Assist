<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,DisableBaselineAlignment,ButtonStyle,UseCompoundDrawables" android:baselineAligned="false" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#070B14" android:orientation="vertical" android:gravity="center"
    android:padding="28dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="@string/auto_extracted_41" android:textColor="#E8EEF9"
      android:textSize="30sp" android:textStyle="bold" android:letterSpacing="0.06"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="@string/auto_extracted_42" android:textColor="#9FB3D1"
      android:textSize="15sp" android:layout_marginTop="10dp" android:layout_marginBottom="40dp"/>
  <ProgressBar android:id="@+id/updateProgressBar"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent" android:layout_height="10dp"
      android:progressDrawable="@android:drawable/progress_horizontal"
      android:progressTint="#7C4DFF" android:progressBackgroundTint="#1E2A44"
      android:visibility="gone" android:max="100"/>
  <TextView android:id="@+id/progressText"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="#00D4FF" android:layout_marginTop="10dp" android:visibility="gone"
      android:fontFamily="monospace" android:text="@string/auto_extracted_43"/>
  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnDownloadUpdate" android:layout_width="match_parent"
      android:layout_height="56dp" android:layout_marginTop="36dp"
      android:background="@drawable/button_premium" android:textColor="#FFFFFF"
      android:textSize="16sp" android:textStyle="bold" android:letterSpacing="0.06"
      android:text="@string/auto_extracted_44"/>
  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnSkipUpdate" android:layout_width="match_parent"
      android:layout_height="48dp" android:layout_marginTop="14dp"
      android:background="@drawable/btn_ghost" android:textColor="#5C7399"
      android:text="@string/auto_extracted_45"/>
</LinearLayout>
