<?xml version="1.0" encoding="utf-8"?>
<!--
  In-app update screen (File No 96) — round no60, premium re-touch.

  ORPHANED (PROVEN): no activity inflates this layout — no
  UpdateActivity exists, no code references R.layout.activity_update
  or any of its four ids (updateProgressBar, progressText,
  btnDownloadUpdate, btnSkipUpdate), and no update-check code exists
  in app/ or core/ (grep, HEAD 850341fe). The REQUEST_INSTALL_PACKAGES
  permission is declared, but nothing drives this screen. Kept and
  upgraded, not deleted (no-delete rule). Wiring it to a real update
  flow is Ed's call (queued).

  NO60-D21: every hardcoded colour -> theme token (background
  ?android:attr/colorBackground, title ?attr/colorOnSurface, subtitle
  ?attr/colorOnSurfaceVariant, percentage ?attr/colorSecondary). Title
  and subtitle use the theme text appearances.
  NO60-D22: the progress bar no longer hand-rolls its tints — it uses
  Widget.SplendorAssist.ProgressBar.Horizontal (theme primary on the
  container track); the explicit @android:drawable/progress_horizontal
  is the style parent's drawable, so it is dropped. The percentage
  uses the Mono appearance.
  NO60-D23: both buttons now use the button styles (Filled for
  DOWNLOAD & INSTALL, Ghost.Dim for SKIP FOR NOW) instead of a
  background + per-view text attributes; the 56dp/48dp heights and
  the gone-by-default progress views are unchanged.
-->
<LinearLayout xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,DisableBaselineAlignment,ButtonStyle,UseCompoundDrawables" android:baselineAligned="false" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:orientation="vertical" android:gravity="center"
    android:padding="28dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="@string/auto_extracted_41" android:textColor="?attr/colorOnSurface"
      android:textAppearance="@style/TextAppearance.SplendorAssist.Display" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="@string/auto_extracted_42" android:textColor="?attr/colorOnSurfaceVariant"
      android:textAppearance="@style/TextAppearance.SplendorAssist.Body"
      android:layout_marginTop="10dp" android:layout_marginBottom="40dp" />
  <ProgressBar android:id="@+id/updateProgressBar"
      style="@style/Widget.SplendorAssist.ProgressBar.Horizontal"
      android:layout_width="match_parent" android:layout_height="10dp"
      android:visibility="gone" android:max="100" />
  <TextView android:id="@+id/progressText"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="?attr/colorSecondary" android:layout_marginTop="10dp" android:visibility="gone"
      android:textAppearance="@style/TextAppearance.SplendorAssist.Mono" android:text="@string/auto_extracted_43" />
  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnDownloadUpdate" android:layout_width="match_parent"
      android:layout_height="56dp" android:layout_marginTop="36dp"
      style="@style/Widget.SplendorAssist.Button.Filled"
      android:text="@string/auto_extracted_44" />
  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnSkipUpdate" android:layout_width="match_parent"
      android:layout_height="48dp" android:layout_marginTop="14dp"
      style="@style/Widget.SplendorAssist.Button.Ghost.Dim"
      android:text="@string/auto_extracted_45" />
</LinearLayout>
