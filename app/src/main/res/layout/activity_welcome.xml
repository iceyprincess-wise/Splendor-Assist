<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,DisableBaselineAlignment,ButtonStyle,UseCompoundDrawables" android:baselineAligned="false" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#070B14" android:gravity="center" android:orientation="vertical"
    android:padding="32dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="@string/auto_extracted_46" android:textColor="#7C4DFF"
      android:textSize="30sp" android:textStyle="bold" android:letterSpacing="0.18"/>
  <View android:layout_width="56dp" android:layout_height="3dp" android:layout_marginTop="14dp"
      android:background="@drawable/accent_bar"/>
  <TextView android:id="@+id/tvCheckState"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="24dp" android:text="@string/auto_extracted_47"
      android:textColor="#9FB3D1" android:textSize="14sp" android:fontFamily="monospace"/>
  <ProgressBar android:layout_width="28dp" android:layout_height="28dp"
      android:layout_marginTop="32dp" android:indeterminateTint="#00D4FF"/>
</LinearLayout>
