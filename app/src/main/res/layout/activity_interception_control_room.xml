<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#070B14" android:fillViewport="true" android:overScrollMode="never">
  <LinearLayout xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,DisableBaselineAlignment,ButtonStyle,UseCompoundDrawables"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/auto_extracted_78" android:textSize="26sp" android:textStyle="bold"
        android:textColor="#E8EEF9" android:letterSpacing="0.02"/>
    <View android:layout_width="56dp" android:layout_height="3dp"
        android:layout_marginTop="10dp" android:layout_marginBottom="20dp"
        android:background="@drawable/accent_bar"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/panel_surface"
        android:padding="8dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_enabled" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_79" android:textColor="#E8EEF9" android:textSize="15sp"
            android:paddingTop="10dp" android:paddingBottom="10dp"/>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_auto_intercept" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_80" android:textColor="#E8EEF9" android:textSize="15sp"
            android:paddingTop="10dp" android:paddingBottom="10dp"/>

    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/auto_extracted_81" android:textSize="12sp" android:textStyle="bold"
        android:textColor="#00D4FF" android:letterSpacing="0.15"
        android:layout_marginTop="20dp" android:layout_marginBottom="10dp"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/seekbar_awareness" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0" android:valueTo="100"
            app:thumbColor="#7C4DFF" app:trackColorActive="#7C4DFF" app:trackColorInactive="#1E2A44"/>
        <TextView android:id="@+id/text_awareness_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_82" android:textColor="#9FB3D1" android:textSize="12sp"
            android:fontFamily="monospace" android:layout_marginBottom="8dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/auto_extracted_83" android:textSize="12sp" android:textStyle="bold"
        android:textColor="#00D4FF" android:letterSpacing="0.15"
        android:layout_marginTop="20dp" android:layout_marginBottom="10dp"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/seekbar_prediction" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0" android:valueTo="100"
            app:thumbColor="#7C4DFF" app:trackColorActive="#7C4DFF" app:trackColorInactive="#1E2A44"/>
        <TextView android:id="@+id/text_prediction_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_84" android:textColor="#9FB3D1" android:textSize="12sp"
            android:fontFamily="monospace" android:layout_marginBottom="8dp"/>
    <TextView android:id="@+id/text_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/auto_extracted_85"
        android:textColor="#9FB3D1" android:textSize="12sp" android:fontFamily="monospace"
        android:background="@drawable/banner_premium" android:padding="12dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_save" android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="24dp" android:text="@string/auto_extracted_86"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"
        android:letterSpacing="0.06" android:background="@drawable/button_premium"/>

  </LinearLayout>
</ScrollView>
