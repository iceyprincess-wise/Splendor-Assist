<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,DisableBaselineAlignment,ButtonStyle,UseCompoundDrawables" android:baselineAligned="false" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#070B14" android:padding="20dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="@string/auto_extracted_1" android:textColor="#FF5252"
      android:textStyle="bold" android:textSize="20sp" android:layout_marginBottom="12dp"/>
  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnCopyLog" android:layout_width="match_parent" android:layout_height="48dp"
      android:text="@string/auto_extracted_2" android:background="@drawable/btn_ghost"
      android:textColor="#00D4FF" android:textStyle="bold" android:textSize="13sp"/>
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
      android:layout_marginTop="12dp" android:background="@drawable/panel_surface">
    <TextView android:id="@+id/txtCrashLog"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#00E676" android:typeface="monospace" android:textSize="12sp"
        android:padding="14dp"/>
  </ScrollView>
</LinearLayout>
