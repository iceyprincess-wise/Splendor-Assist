<?xml version="1.0" encoding="utf-8"?>
<!--
  Fatal-error screen (re-touch, round no60).

  ORPHANED (PROVEN): no activity inflates this layout and no code
  references R.layout.activity_error, btnCopyLog or txtCrashLog (grep,
  HEAD 850341fe). Kept and upgraded, not deleted (no-delete rule).
  Wiring it to the crash flow is Ed's call (queued).

  NO60-D36: hardcoded colours -> theme tokens (background
  ?android:attr/colorBackground, title #FF5252 -> ?attr/colorError,
  log text #00E676 -> ?attr/colorTertiary). The copy button uses the
  Ghost button style (its cyan text comes from the style now).
  All ids and texts preserved.
-->
<LinearLayout xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,DisableBaselineAlignment,ButtonStyle,UseCompoundDrawables" android:baselineAligned="false" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?android:attr/colorBackground" android:padding="20dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="@string/auto_extracted_1" android:textColor="?attr/colorError"
      android:textStyle="bold" android:textSize="20sp" android:layout_marginBottom="12dp"/>
  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnCopyLog" android:layout_width="match_parent" android:layout_height="48dp"
      style="@style/Widget.SplendorAssist.Button.Ghost"
      android:text="@string/auto_extracted_2" android:textStyle="bold" android:textSize="13sp" />
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
      android:layout_marginTop="12dp" android:background="@drawable/panel_surface">
    <TextView android:id="@+id/txtCrashLog"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?attr/colorTertiary"
        android:textAppearance="@style/TextAppearance.SplendorAssist.Mono"
        android:padding="14dp"/>
  </ScrollView>
</LinearLayout>
