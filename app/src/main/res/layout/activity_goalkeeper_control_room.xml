<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_extracted_69"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auto_extracted_70"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_aggressive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_extracted_71"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/auto_extracted_72"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/seekbar_positioning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"/>

        <TextView
            android:id="@+id/text_positioning_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_extracted_73"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/auto_extracted_74"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/seekbar_reactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"/>

        <TextView
            android:id="@+id/text_reactions_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_extracted_75"/>

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/auto_extracted_76"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/auto_extracted_77"/>

    </LinearLayout>

</ScrollView>
