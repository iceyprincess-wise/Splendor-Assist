<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#070B14" android:fillViewport="true" android:overScrollMode="never">
  <LinearLayout xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,DisableBaselineAlignment,ButtonStyle,UseCompoundDrawables"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="24dp">

    <TextView android:id="@+id/tvRoomEmoji"
        android:layout_width="52dp" android:layout_height="52dp"
        android:background="@drawable/panel_surface" android:gravity="center"
        android:text="@string/auto_extracted_58" android:textSize="24sp"
        android:layout_marginBottom="14dp"/>

    <TextView android:id="@+id/tvRoomTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/auto_extracted_59" android:textStyle="bold"
        android:textColor="#E8EEF9" android:textSize="26sp"/>

    <TextView android:id="@+id/tvRoomSubtitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/auto_extracted_60" android:textColor="#9FB3D1"
        android:textSize="13sp" android:layout_marginBottom="20dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/panel_surface"
        android:padding="8dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swEnabled" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_61" android:textColor="#E8EEF9" android:textSize="15sp"
            android:paddingTop="10dp" android:paddingBottom="10dp"/>

    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TUNING" android:textSize="12sp" android:textStyle="bold"
        android:textColor="#00D4FF" android:letterSpacing="0.15"
        android:layout_marginTop="20dp" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/auto_extracted_62" android:textColor="#9FB3D1" android:textSize="12sp"
            android:layout_marginBottom="6dp"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/seekIntensity" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0" android:valueTo="100"
            app:thumbColor="#7C4DFF" app:trackColorActive="#7C4DFF" app:trackColorInactive="#1E2A44"/>
        <TextView android:id="@+id/tvRoomStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#9FB3D1" android:textSize="12sp" android:fontFamily="monospace"
            android:layout_marginTop="14dp" android:background="@drawable/banner_premium"
            android:padding="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="0dp" android:orientation="horizontal">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="54dp"
        android:layout_marginTop="24dp" android:text="@string/auto_extracted_63"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"
        android:letterSpacing="0.06" android:background="@drawable/button_premium"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack" android:layout_width="0dp" android:layout_weight="1" android:layout_height="54dp"
        android:layout_marginTop="24dp" android:text="@string/auto_extracted_64"
        android:textColor="#00D4FF" android:textStyle="bold" android:textSize="15sp"
        android:letterSpacing="0.06" android:background="@drawable/btn_ghost"/>
    </LinearLayout>

  </LinearLayout>
</ScrollView>
