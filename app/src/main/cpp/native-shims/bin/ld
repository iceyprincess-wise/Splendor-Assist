#!/usr/bin/env bash
set -uo pipefail

canon_path() {
  local p="$1"

  if command -v readlink >/dev/null 2>&1; then
    readlink -f "$p" 2>/dev/null && return 0
  fi

  local d b
  d="$(dirname "$p")"
  b="$(basename "$p")"

  if cd "$d" 2>/dev/null; then
    printf '%s/%s\n' "$PWD" "$b"
    return 0
  fi

  printf '%s\n' "$p"
}

SELF="$(canon_path "$0")"

NDK_ROOT="${SPLENDOR_NDK_ROOT:-/data/data/com.termux/files/home/android-sdk/ndk/25.1.8937393}"
TERMUX_CLANG_LIB_PREFIX="/data/data/com.termux/files/usr/lib/clang"

find_runnable_ld() {
  local c rc
  local -a candidates=()
  local -a glob_candidates=()

  if [ -n "${SPLENDOR_REAL_LD:-}" ]; then
    candidates+=("$SPLENDOR_REAL_LD")
  fi

  c="$(command -v ld.lld 2>/dev/null || true)"
  if [ -n "$c" ]; then
    candidates+=("$c")
  fi

  candidates+=("/data/data/com.termux/files/usr/bin/ld.lld")

  shopt -s nullglob
  glob_candidates=("$NDK_ROOT"/toolchains/llvm/prebuilt/*/bin/ld.lld)
  shopt -u nullglob
  if [ "${#glob_candidates[@]}" -gt 0 ]; then
    candidates+=("${glob_candidates[@]}")
  fi

  candidates+=("$NDK_ROOT/toolchains/llvm/prebuilt/bin/ld.lld")

  for c in "${candidates[@]}"; do
    [ -n "$c" ] || continue
    [ -x "$c" ] || continue

    rc="$(canon_path "$c")"
    [ "$rc" = "$SELF" ] && continue

    if "$c" --version >/dev/null 2>&1; then
      printf '%s\n' "$c"
      return 0
    fi
  done

  local -a alias_candidates=()

  c="$(command -v ld 2>/dev/null || true)"
  if [ -n "$c" ]; then
    alias_candidates+=("$c")
  fi

  alias_candidates+=("/data/data/com.termux/files/usr/bin/ld")

  shopt -s nullglob
  glob_candidates=("$NDK_ROOT"/toolchains/llvm/prebuilt/*/bin/ld)
  shopt -u nullglob
  if [ "${#glob_candidates[@]}" -gt 0 ]; then
    alias_candidates+=("${glob_candidates[@]}")
  fi

  alias_candidates+=("$NDK_ROOT/toolchains/llvm/prebuilt/bin/ld")

  for c in "${alias_candidates[@]}"; do
    [ -n "$c" ] || continue
    [ -x "$c" ] || continue

    rc="$(canon_path "$c")"
    [ "$rc" = "$SELF" ] && continue

    if "$c" --version 2>&1 | grep -qi 'LLD'; then
      printf '%s\n' "$c"
      return 0
    fi
  done

  return 1
}

REAL_LD="$(find_runnable_ld)"
if [ -z "$REAL_LD" ] || [ ! -x "$REAL_LD" ]; then
  echo "splendor-ld-wrapper-v9: no runnable ld.lld found" >&2
  exit 127
fi

SYSROOT=""
API=""

declare -a ARGS=()

for a in "$@"; do
  case "$a" in
    --sysroot=*)
      SYSROOT="${a#--sysroot=}"
      ;;
    -L*)
      dir="${a#-L}"
      dir="${dir%/}"
      if [[ "$dir" == */aarch64-linux-android/* ]]; then
        base="${dir##*/}"
        if [[ "$base" =~ ^[0-9]+$ ]]; then
          API="$base"
        fi
      fi
      ;;
  esac

  ARGS+=("$a")
done

if [ -z "$SYSROOT" ] && [ -n "$NDK_ROOT" ] && [ -d "$NDK_ROOT" ]; then
  shopt -s nullglob
  sys_cands=(
    "$NDK_ROOT/toolchains/llvm/prebuilt/sysroot"
    "$NDK_ROOT"/toolchains/llvm/prebuilt/*/sysroot
  )
  shopt -u nullglob

  if [ "${#sys_cands[@]}" -gt 0 ]; then
    SYSROOT="${sys_cands[0]}"
  fi
fi

ARCH_DIR=""
if [ -n "$SYSROOT" ]; then
  ARCH_DIR="$SYSROOT/usr/lib/aarch64-linux-android"
fi

find_lib() {
  local name="$1"
  local d
  local -a dirs=()

  if [ -n "$API" ] && [ -n "$ARCH_DIR" ]; then
    dirs+=("$ARCH_DIR/$API")
  fi

  if [ -n "$ARCH_DIR" ]; then
    dirs+=("$ARCH_DIR")
  fi

  if [ -n "$SYSROOT" ]; then
    dirs+=("$SYSROOT/usr/lib")
  fi

  for d in "${dirs[@]}"; do
    if [ -f "$d/$name" ]; then
      printf '%s\n' "$d/$name"
      return 0
    fi
  done

  if [ -n "$SYSROOT" ] && [ -d "$SYSROOT/usr/lib" ]; then
    local f
    f="$(find "$SYSROOT/usr/lib" -maxdepth 5 -type f -name "$name" 2>/dev/null | head -n 1 || true)"
    if [ -n "$f" ]; then
      printf '%s\n' "$f"
      return 0
    fi
  fi

  return 1
}

LIBC_SO="$(find_lib libc.so || true)"
LIBM_SO="$(find_lib libm.so || true)"
LIBDL_SO="$(find_lib libdl.so || true)"
LIBATOMIC_SO="$(find_lib libatomic.so || true)"
LIBCXX_SO="$(find_lib libc++_shared.so || true)"
LIBLOG_SO="$(find_lib liblog.so || true)"

if [ -z "$LIBC_SO" ]; then
  echo "splendor-ld-wrapper-v9: libc.so not found; SYSROOT=$SYSROOT ARCH_DIR=$ARCH_DIR API=$API" >&2
  exit 2
fi

declare -a OUT=()

add_dyn() {
  local lib="$1"
  [ -z "$lib" ] && return 0
  OUT+=("-Bdynamic" "$lib")
}

for a in "${ARGS[@]}"; do
  if [[ "$a" == -Wl,* ]]; then
    rest="${a#-Wl,}"
    IFS=',' read -r -a parts <<< "$rest"
    for part in "${parts[@]}"; do
      [ -n "$part" ] && OUT+=("$part")
    done
    continue
  fi

  if [[ "$a" == "$TERMUX_CLANG_LIB_PREFIX"/*.a ]]; then
    continue
  fi

  if [[ "$a" == *"libc.a("* ]]; then
    continue
  fi

  if [[ "$a" == *"/libc.a" || "$a" == "libc.a" ]]; then
    continue
  fi

  if [[ "$a" == *libclang_rt.*.a ]]; then
    continue
  fi

  case "$a" in
    -lclang_rt*|-l:*clang_rt*|-lgwp_asan|-lasan|-lhwaddress|-ltsan|-lubsan|-lscudo)
      continue
      ;;
  esac

  case "$a" in
    -lc|-l:c)
      add_dyn "$LIBC_SO"
      ;;
    -lm|-l:m)
      if [ -n "$LIBM_SO" ]; then
        add_dyn "$LIBM_SO"
      else
        OUT+=("$a")
      fi
      ;;
    -ldl|-l:dl)
      if [ -n "$LIBDL_SO" ]; then
        add_dyn "$LIBDL_SO"
      else
        OUT+=("$a")
      fi
      ;;
    -latomic|-l:atomic)
      if [ -n "$LIBATOMIC_SO" ]; then
        add_dyn "$LIBATOMIC_SO"
      else
        OUT+=("$a")
      fi
      ;;
    -lc++_shared|-l:c++_shared)
      if [ -n "$LIBCXX_SO" ]; then
        add_dyn "$LIBCXX_SO"
      else
        OUT+=("$a")
      fi
      ;;
    -llog|-l:log)
      if [ -n "$LIBLOG_SO" ]; then
        add_dyn "$LIBLOG_SO"
      else
        OUT+=("$a")
      fi
      ;;
    *)
      OUT+=("$a")
      ;;
  esac
done

append_if_missing() {
  local lib="$1"
  [ -z "$lib" ] && return 0

  if [ "${#OUT[@]}" -gt 0 ]; then
    local x
    for x in "${OUT[@]}"; do
      if [ "$x" = "$lib" ]; then
        return 0
      fi
    done
  fi

  add_dyn "$lib"
}

append_if_missing "$LIBC_SO"
append_if_missing "$LIBM_SO"
append_if_missing "$LIBDL_SO"
append_if_missing "$LIBATOMIC_SO"
append_if_missing "$LIBCXX_SO"
append_if_missing "$LIBLOG_SO"

NDK_BUILTINS=""

shopt -s nullglob
builtin_cands=(
  "$NDK_ROOT"/toolchains/llvm/prebuilt/*/lib64/clang/*/lib/linux/aarch64/libclang_rt.builtins-aarch64-android.a
  "$NDK_ROOT"/toolchains/llvm/prebuilt/lib64/clang/*/lib/linux/aarch64/libclang_rt.builtins-aarch64-android.a
)
shopt -u nullglob

if [ "${#builtin_cands[@]}" -gt 0 ]; then
  NDK_BUILTINS="${builtin_cands[0]}"
fi

if [ -n "$NDK_BUILTINS" ] && [ -f "$NDK_BUILTINS" ]; then
  NM_BIN="${SPLENDOR_NM:-}"
  if [ -z "$NM_BIN" ]; then
    NM_BIN="$(command -v llvm-nm || command -v nm || true)"
  fi

  bad=0
  if [ -n "$NM_BIN" ]; then
    if "$NM_BIN" -g "$NDK_BUILTINS" 2>/dev/null | grep -Eq 'gwp_asan|getThreadLocals|StaticTlsLayout|__gwp_asan'; then
      bad=1
    fi
  fi

  if [ "$bad" -eq 0 ]; then
    OUT+=("$NDK_BUILTINS")
  fi
fi

exec "$REAL_LD" "${OUT[@]}"
