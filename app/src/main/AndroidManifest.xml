<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Batch booster (queue item 4, free booster engine): the transport
         preference request needs CHANGE_NETWORK_STATE (normal permission,
         no runtime grant); the real signal reading needs READ_PHONE_STATE
         (dangerous — asked once per process in MainActivity, denial never
         blocks the pipeline). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />


    <application android:gwpAsanMode="always" tools:targetApi="r"
        android:name="com.assistant.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Splendor Assist"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.SplendorAssist">

        <activity android:name="com.assistant.controlroom.ui.SmartAssistControlRoomActivity" android:exported="false" />
        <activity android:name="com.assistant.controlroom.ui.GoalkeeperControlRoomActivity" android:exported="false" />
        <activity android:name="com.assistant.controlroom.ui.InterceptionControlRoomActivity" android:exported="false" />
        <activity android:name="com.assistant.controlroom.ui.FutureRoomsActivity" android:exported="false" />
        <activity android:name="com.assistant.controlroom.ui.AgentHubActivity" android:exported="false" />
        <activity android:name="com.assistant.controlroom.ui.GameplayRoomActivity" android:exported="false" />
        <!-- UI-2: Diagnosis Room (live engine/file status, no logs) and
             Notification Room (app issues, tap one to see the diagnosis). -->
        <activity android:name="com.assistant.controlroom.ui.DiagnosisRoomActivity" android:exported="false" />
        <activity android:name="com.assistant.controlroom.ui.NotificationRoomActivity" android:exported="false" />
        <!-- F-PERMS3: in-app Permissions overview (every permission the
             app needs, granted/missing from the real APIs, tap to fix).
             The system's App permissions page only lists the two runtime
             permissions, so this room is the one place Ed can see them all. -->
        <activity android:name="com.assistant.controlroom.ui.PermissionsRoomActivity" android:exported="false" />
        <activity android:name="com.assistant.UpdateActivity" android:exported="false" />

        <!-- Updater Piece 4: FileProvider for the install intent — the
             downloaded release APK lives in the app's external files
             Download/ dir and is shared with the package installer via
             authority com.assistant.overlay.fileprovider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.assistant.overlay.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- UI-2: the launch splash is now the LAUNCHER — it shows the
             logo page loading, then proceeds to MainActivity (and, from
             the updater piece, to the update page only when an update
             is confirmed available). MainActivity keeps exported=true
             (ProjectionRequestReceiver starts it) but is no longer the
             launcher entry point. -->
        <activity android:name="com.assistant.SplashActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.assistant.MainActivity" android:exported="true" />
        
        <activity android:name="com.assistant.SplendorReauthActivity" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- F37-D10: receiver for the capture-recovery prompt tap
             (com.assistant.REQUEST_PROJECTION). Previously no receiver
             existed, so the tap did nothing.
             NAMESPACE TRAP (2026-11-21 crash loop): a relative name
             resolves against the manifest namespace
             (com.assistant.overlay), NOT the class package
             (com.assistant) — the relative form pointed at a class
             that does not exist and every recovery broadcast crashed
             the process (ClassNotFoundException). Keep fully-qualified. -->
        <receiver android:name="com.assistant.ProjectionRequestReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.assistant.REQUEST_PROJECTION" />
            </intent-filter>
        </receiver>
        
        
        

        <!-- C2/C3 (batch 5b): mediaProjection|specialUse. The MediaProjection
             grant dies with the crashed process, so a sticky restart after
             ANY crash could never re-enter foreground as mediaProjection
             alone (SecurityException, v219 2026-11-19 16:35:55 + 16:51:29);
             startForegroundSafely() falls back to SPECIAL_USE on that
             refusal. Subtype states the real use: screen capture of the
             game for the on-device vision pipeline. -->
        <service
            android:name="com.assistant.OverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Captures the game screen for on-device vision that drives the assist overlay while playing." />
        </service>

        <service
            android:name="com.assistant.SmartAssistAccessibilityEngine"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        

        

        

        

        

        

        

        

        

        <service
            android:name="com.assistant.adapter.watchdog.WatchdogAdapterService"
            android:exported="false"
            android:process=":survival"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Supervises adapter health, failures and recovery telemetry." />
        </service>

        

        

        

        

        

        <!-- Batch 6b: PingEliminatorVpnService entry REMOVED with the
             class (verdict: tunnel with no upstream cannot reduce ping;
             a real upstream needs Ed's server decision). Do not re-add
             a VpnService entry without that decision. -->

        <service
            android:name="com.assistant.PerformanceEngineService"
            android:exported="false"
            android:process=":survival"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Consolidated performance domain (lag, stutter, net, input, lmk, memory, thermal, battery)." />
        </service>
    
        <service
            android:name="com.assistant.GameplayEngineService"
            android:exported="false"
            android:process=":survival"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Consolidated gameplay domain (movement, passing, shooting, defending, keeper, tactical)." />
        </service>
    </application>
</manifest>
